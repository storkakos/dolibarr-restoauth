# Every text file gets LF in the working tree, also on Windows with core.autocrlf=true.
# PHP, SQL, shell scripts and the language files end up in Linux containers (Dolibarr in the test
# stack, the release ZIP); a trailing \r breaks shell scripts there and pollutes PHP output.
* text=auto eol=lf
*.php text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.lang text eol=lf
*.json text eol=lf
*.md text eol=lf

# Not part of the release ZIP (scripts/build-release-zip.sh uses `git archive`, which honours
# export-ignore). README.md, CHANGELOG.md and LICENSE stay in the ZIP.
.gitattributes export-ignore
.gitignore export-ignore
AGENTS.md export-ignore
docs/ export-ignore
scripts/ export-ignore
